---
import Base from '../layouts/Base.astro';
import WordHero from '../components/WordHero.astro';
import ServiceList from '../components/ServiceList.astro';
import CtaBand from '../components/CtaBand.astro';
import { getCoverPhoto, getPages } from '../lib/content';

// Services page text — edit here.
const meta = {
  title: 'Architecture & Interior Design Services | Studio Infinity',
  description:
    'Residential architecture, commercial architecture and interior design services from Studio Infinity in Mumbai, Delhi, Bangalore and Jaipur.',
};
const intro = 'From the first sketch to the finished space, we work across residential, commercial and interior projects.';

const services = await getPages('service');
const items = await Promise.all(
  services.map(async (p) => ({
    title: p.data.title,
    href: `/${p.id}/`,
    summary: p.data.summary,
    photo: p.data.heroImage ?? (await getCoverPhoto({ category: p.data.category }))?.src,
  })),
);
---

<Base title={meta.title} description={meta.description} breadcrumbs={[{ name: 'Services', path: '/services/' }]}>
  <WordHero word="services" label="Services" chip="What we do" meta={[`${String(services.length).padStart(2, '0')} disciplines`]} intro={intro} />

  <section class="section section--flush-top container" aria-label="Our services">
    <ServiceList items={items} />
  </section>

  <CtaBand />
</Base>
