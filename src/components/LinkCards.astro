---
// Large typographic list of links with hairlines between rows (services, locations, related pages).
import { url } from '../lib/url';

interface Props {
  items: { title: string; href: string; summary?: string }[];
  numbered?: boolean;
}

const { items, numbered = true } = Astro.props;
---

<ul class="type-list">
  {
    items.map((item, i) => (
      <li data-reveal style={`--reveal-i: ${i % 4}`}>
        <a href={url(item.href)}>
          {numbered && (
            <span class="type-list__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
          )}
          <span class="type-list__title">{item.title}</span>
          {item.summary && <span class="type-list__summary">{item.summary}</span>}
          <span class="type-list__arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .type-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
  }

  .type-list a {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: baseline;
    gap: 0.25rem var(--space-3);
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
  }

  /* Hairline that draws across in bronze on hover. */
  .type-list a::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease);
  }

  .type-list a:hover::before,
  .type-list a:focus-visible::before {
    transform: scaleX(1);
  }

  .type-list__num {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
  }

  .type-list__title {
    font-size: clamp(1.625rem, 3.4vw, 2.75rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.02em;
    transition: transform 500ms var(--ease);
  }

  .type-list a:hover .type-list__title {
    transform: translateX(0.75rem);
  }

  .type-list__summary {
    grid-column: 2;
    max-width: 34rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .type-list__arrow {
    grid-column: 3;
    grid-row: 1;
    color: var(--color-accent);
    font-size: 1.5rem;
    font-weight: 300;
    opacity: 0;
    transform: translateX(-12px);
    transition:
      opacity 400ms var(--ease),
      transform 400ms var(--ease);
  }

  .type-list a:hover .type-list__arrow,
  .type-list a:focus-visible .type-list__arrow {
    opacity: 1;
    transform: none;
  }

  /* Wide screens: summary sits in its own column to the right of the title. */
  @media (min-width: 64rem) {
    .type-list a {
      grid-template-columns: 4rem minmax(0, 1.4fr) minmax(0, 1fr) 2rem;
    }

    .type-list__summary {
      grid-column: 3;
      grid-row: 1;
    }

    .type-list__arrow {
      grid-column: 4;
      justify-self: end;
    }
  }

  @media (hover: none) {
    .type-list__arrow {
      opacity: 1;
      transform: none;
    }
  }
</style>
