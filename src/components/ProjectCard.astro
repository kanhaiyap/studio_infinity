---
import { Image, getImage } from 'astro:assets';
import type { Project } from '../lib/content';
import { projectCategories } from '../site';

interface Props {
  project: Project;
  index?: number;
  eager?: boolean;
}

const { project, index = 0, eager = false } = Astro.props;
const { title, category, city, year, cover, coverAlt, gallery } = project.data;
const categoryLabel = projectCategories[category];
const alt = coverAlt ?? `${title}, ${categoryLabel.toLowerCase()} project in ${city}`;

// Full-size photos for the lightbox: cover first, then the gallery.
const photos = [...(cover ? [{ src: cover, alt }] : []), ...gallery];
const slides = await Promise.all(
  photos.map(async (photo) => {
    const img = await getImage({ src: photo.src, width: Math.min(photo.src.width, 2400), format: 'webp' });
    return { src: img.src, width: img.attributes.width, height: img.attributes.height, alt: photo.alt };
  }),
);
---

<article class="project-card" data-category={category} data-project={project.id} data-slot={(index % 4) + 1} data-reveal style={`--reveal-i: ${index % 2}`}>
  <div class="project-card__media" data-parallax>
    {
      cover ? (
        <Image
          src={cover}
          alt={alt}
          widths={[400, 700, 1000, 1400]}
          sizes="(min-width: 48rem) 60vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="project-card__placeholder" aria-hidden="true">
          <span>photo to come</span>
        </div>
      )
    }
    {
      slides.length > 0 && (
        <a class="project-card__zoom" href={slides[0].src} data-gallery={JSON.stringify(slides)}>
          <span class="visually-hidden">
            View {slides.length} photo{slides.length === 1 ? '' : 's'} of {title}
          </span>
          <span class="project-card__zoom-icon" aria-hidden="true" data-magnetic>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />
            </svg>
          </span>
        </a>
      )
    }
  </div>
  <h3>{title}</h3>
  <p class="project-card__meta">
    {categoryLabel} · {city}{year && ` · ${year}`}
  </p>
</article>

<style>
  .project-card__media {
    position: relative;
    aspect-ratio: var(--ratio, 4 / 3);
    overflow: hidden;
    margin-bottom: var(--space-2);
    background: var(--color-stone);
  }

  /* One transform combines three effects: scroll parallax (--py, set by parallax.ts),
     the reveal zoom and the hover zoom (--zoom). */
  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(calc(var(--py, 0) * 1%)) scale(var(--zoom, 1));
    transition: transform 900ms var(--ease);
  }

  .project-card:hover .project-card__media img,
  .project-card:focus-within .project-card__media img {
    --zoom: 1.05;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-card__media img {
      --zoom: 1.1; /* extra room so the parallax drift never shows an edge */
    }

    .project-card:hover .project-card__media img,
    .project-card:focus-within .project-card__media img {
      --zoom: 1.16;
    }

    /* Scroll reveal: the photo wipes open from the bottom while settling from a deeper zoom. */
    .project-card__media {
      transition: clip-path 1300ms var(--ease);
    }

    :global(.js) .project-card:not(.is-visible) .project-card__media {
      clip-path: inset(100% 0 0 0);
    }

    :global(.js) .project-card:not(.is-visible) .project-card__media img {
      --zoom: 1.3;
    }
  }

  .project-card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    letter-spacing: 0.12em;
  }


  /* The whole photo is the lightbox link, so it works by tap as well as hover. */
  .project-card__zoom {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    background: rgb(31 29 26 / 0);
    color: var(--color-on-inverse);
    cursor: zoom-in;
    transition: background-color var(--dur-slow) var(--ease);
  }

  .project-card__zoom-icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-bg);
    color: var(--color-text);
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity var(--dur-slow) var(--ease),
      transform 300ms var(--ease);
  }

  .project-card__zoom:hover,
  .project-card__zoom:focus-visible {
    background: rgb(31 29 26 / 0.28);
  }

  .project-card__zoom:hover .project-card__zoom-icon,
  .project-card__zoom:focus-visible .project-card__zoom-icon {
    opacity: 1;
    transform: none;
  }

  .project-card__zoom:focus-visible {
    outline-offset: -4px;
    outline-color: var(--color-on-inverse);
  }

  /* Touch screens: show the icon small in the corner since there's no hover. */
  @media (hover: none) {
    .project-card__zoom {
      place-items: start end;
      padding: 0.75rem;
    }

    .project-card__zoom-icon {
      width: 2.75rem;
      height: 2.75rem;
      opacity: 0.92;
      transform: none;
    }
  }

  .project-card h3 {
    margin-bottom: 0.35rem;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    font-weight: 300;
    letter-spacing: -0.01em;
  }

  .project-card__meta {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
</style>
