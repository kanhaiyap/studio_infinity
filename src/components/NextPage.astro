---
// Full-width link to the next page in a series (cities, services). A word (the city or service name) spreads
// across the width like the city hero's; on hover/focus a photo wipes up behind the letters
// (always shown on touch screens).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

interface Props {
  href: string;
  title: string; // e.g. "Architect in Delhi"
  word: string; // spread across the width, e.g. "delhi"
  label: string; // e.g. "Next location"
  photo?: ImageMetadata;
}

const { href, title, word, label, photo } = Astro.props;
const letters = [...word.toLowerCase()];
---

<section class="next-page" aria-label={label}>
  <a class:list={['next-page__link', { 'next-page__link--photo': photo }]} href={url(href)} style={`--len: ${letters.length}`}>
    {photo && <Image class="next-page__photo" src={photo} alt="" widths={[800, 1400, 2000]} sizes="100vw" />}
    <span class="container next-page__label">
      <span>{label}</span>
      <span class="next-page__title">{title} <span class="next-page__arrow" aria-hidden="true">→</span></span>
    </span>
    <span class="next-page__name" aria-hidden="true">
      {letters.map((letter) => <span>{letter}</span>)}
    </span>
  </a>
</section>

<style>
  .next-page {
    border-top: 1px solid var(--color-border);
  }

  .next-page__link {
    position: relative;
    display: block;
    overflow: hidden;
    padding-top: var(--space-5);
    color: var(--color-text);
    text-decoration: none;
    isolation: isolate;
    transition: color 500ms var(--ease);
  }

  .next-page__link:focus-visible {
    outline: 2px solid var(--color-pop);
    outline-offset: -4px;
  }

  /* Lime bar that slides in along the bottom on hover/focus. */
  .next-page__link::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 4px;
    background: var(--color-pop);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 700ms var(--ease);
  }

  .next-page__link:hover::after,
  .next-page__link:focus-visible::after {
    transform: none;
  }

  /* Photo, hidden below until hover/focus. */
  .next-page__photo {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(100% 0 0 0);
    filter: brightness(0.62);
    transform: scale(1.08);
    transition:
      clip-path 900ms var(--ease),
      transform 1400ms var(--ease);
  }

  .next-page__link--photo:hover,
  .next-page__link--photo:focus-visible {
    color: #fff;
  }

  /* On the photo, the label row turns lime. */
  .next-page__link--photo:hover .next-page__label,
  .next-page__link--photo:focus-visible .next-page__label {
    color: var(--color-pop);
  }

  .next-page__link:hover .next-page__photo,
  .next-page__link:focus-visible .next-page__photo {
    clip-path: inset(0);
    transform: none;
  }

  /* No hover on touch screens: show the photo from the start. */
  @media (hover: none) {
    .next-page__link--photo {
      color: #fff;
    }

    .next-page__link--photo .next-page__label {
      color: var(--color-pop);
    }

    .next-page__photo {
      clip-path: inset(0);
      transform: none;
    }
  }

  .next-page__label {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .next-page__title {
    display: inline-flex;
    gap: 0.75em;
  }

  .next-page__arrow {
    transition: transform 450ms var(--ease);
  }

  .next-page__link:hover .next-page__arrow {
    transform: translateX(0.5em);
  }

  .next-page__name {
    display: flex;
    justify-content: space-between;
    padding: var(--space-3) var(--gutter) var(--space-4);
    font-size: min(calc(120vw / var(--len)), 14rem);
    font-weight: 500;
    line-height: 0.85;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next-page__name > span {
      transition: transform 700ms var(--ease);
    }

    .next-page__link:hover .next-page__name > span {
      transform: translateY(-0.06em);
    }
  }
</style>
