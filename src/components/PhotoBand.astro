---
// Full-bleed band of project photos in staggered heights, each drifting slightly on scroll,
// with a link to the Projects page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
---

{
  photos.length > 0 && (
    <section class="photo-band" aria-label="Our work">
      <div class="photo-band__row">
        {photos.map((photo, i) => (
          <div class="photo-band__item" data-parallax data-reveal style={`--reveal-i: ${i}`}>
            <Image src={photo.src} alt={photo.alt} widths={[400, 700, 1000]} sizes="(min-width: 60rem) 25vw, 50vw" />
          </div>
        ))}
      </div>
      <div class="container photo-band__link">
        <a class="button" href={url('/projects/')} data-magnetic>
          see our projects
        </a>
      </div>
    </section>
  )
}

<style>
  .photo-band {
    padding-bottom: var(--space-6);
    overflow: hidden;
  }

  .photo-band__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: clamp(0.5rem, 1.5vw, 1.25rem);
    padding-inline: var(--gutter);
  }

  @media (min-width: 60rem) {
    .photo-band__row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .photo-band__item {
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }

  /* Staggered heights: every other photo sits lower. */
  .photo-band__item:nth-child(even) {
    margin-top: clamp(2rem, 8vw, 7rem);
  }

  .photo-band__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(calc(var(--py, 0) * 1.5%)) scale(1.12);
  }

  .photo-band__link {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-4);
  }
</style>
