---
// Full-screen photo slider for the home hero. The page heading goes in the "heading" slot and sits
// over the photos (bottom left); the current project and the controls sit bottom right.
import { Image } from 'astro:assets';
import type { Project } from '../lib/content';
import { projectCategories } from '../site';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
const first = projects[0].data;
---

<div class="hero-slider">
  <div class="slider" role="region" aria-roledescription="carousel" aria-label="Featured projects" tabindex="0" data-slider>
    <div class="slider__slides" aria-live="off" data-slides>
      {
        projects.map((project, i) => {
          const { title, category, city, cover, coverAlt } = project.data;
          return (
            <figure
              class:list={['slide', { 'is-active': i === 0 }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${projects.length}`}
              aria-hidden={i === 0 ? undefined : 'true'}
              data-title={title}
              data-city={city}
            >
              {cover ? (
                <Image
                  src={cover}
                  alt={coverAlt ?? `${title}, ${projectCategories[category].toLowerCase()} project in ${city}`}
                  widths={[800, 1280, 1920, 2560]}
                  sizes="100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              ) : (
                <div class="slide__placeholder" aria-hidden="true" />
              )}
              <figcaption class="visually-hidden">
                {title}, {city}
              </figcaption>
            </figure>
          );
        })
      }
    </div>

    <div class="slider__bar">
      <p class="slider__now" aria-hidden="true">
        <span data-now-title>{first.title}</span>
        <span class="slider__city" data-now-city>{first.city}</span>
      </p>
      {
        projects.length > 1 && (
          <div class="slider__controls">
            <button type="button" class="slider__button slider__button--quiet" aria-label="Pause slideshow" data-toggle>
              <svg class="icon-pause" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                <rect x="6" y="5" width="3" height="14" />
                <rect x="15" y="5" width="3" height="14" />
              </svg>
              <svg class="icon-play" viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true">
                <path d="M7 5v14l12-7z" />
              </svg>
            </button>
            <button type="button" class="slider__button" aria-label="Previous slide" data-prev data-magnetic>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <path d="M19 12H5M11 6l-6 6 6 6" />
              </svg>
            </button>
            <button type="button" class="slider__button" aria-label="Next slide" data-next data-magnetic>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>
        )
      }
    </div>
  </div>

  <div class="container hero-slider__content">
    <slot name="heading" />
  </div>
</div>

<script>
  const INTERVAL = 6500;

  const root = document.querySelector<HTMLElement>('[data-slider]');
  const slides = root ? [...root.querySelectorAll<HTMLElement>('.slide')] : [];

  if (root && slides.length > 1) {
    const slidesBox = root.querySelector<HTMLElement>('[data-slides]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const now = root.querySelector<HTMLElement>('.slider__now')!;
    const nowTitle = root.querySelector<HTMLElement>('[data-now-title]')!;
    const nowCity = root.querySelector<HTMLElement>('[data-now-city]')!;

    let current = 0;
    let userPaused = matchMedia('(prefers-reduced-motion: reduce)').matches; // no autoplay when reduced motion is requested
    let focusPaused = false;
    let timer: number | undefined;
    let startedAt = 0;
    let remaining = INTERVAL;

    const isPaused = () => userPaused || focusPaused || document.hidden;

    const schedule = () => {
      window.clearTimeout(timer);
      if (isPaused()) return;
      startedAt = performance.now();
      timer = window.setTimeout(() => go(current + 1, 1), remaining);
    };

    const syncState = () => {
      slidesBox.setAttribute('aria-live', isPaused() ? 'polite' : 'off');
      toggle.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
      root.classList.toggle('is-user-paused', userPaused);
    };

    // Pauses/resumes autoplay, keeping the time already elapsed on the current slide.
    const setPaused = (update: () => void) => {
      const wasPaused = isPaused();
      if (!wasPaused) {
        window.clearTimeout(timer);
        remaining = Math.max(0, remaining - (performance.now() - startedAt));
      }
      update();
      if (wasPaused && !isPaused()) schedule();
      syncState();
    };

    const go = (index: number, direction: 1 | -1) => {
      const next = (index + slides.length) % slides.length;
      if (next === current) return;
      const prev = slides[current];
      const incoming = slides[next];

      root.style.setProperty('--dir', String(direction));
      slides.forEach((s) => s.classList.remove('is-leaving', 'is-entering'));
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      prev.setAttribute('aria-hidden', 'true');
      incoming.classList.add('is-active', 'is-entering');
      incoming.removeAttribute('aria-hidden');

      nowTitle.textContent = incoming.dataset.title ?? '';
      nowCity.textContent = incoming.dataset.city ?? '';
      now.classList.remove('is-changing');
      void now.offsetWidth; // restart the fade
      now.classList.add('is-changing');

      current = next;
      remaining = INTERVAL;
      schedule();
    };

    root.querySelector('[data-next]')?.addEventListener('click', () => go(current + 1, 1));
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(current - 1, -1));
    toggle.addEventListener('click', () => setPaused(() => (userPaused = !userPaused)));

    root.addEventListener('focusin', () => setPaused(() => (focusPaused = true)));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) setPaused(() => (focusPaused = false));
    });
    document.addEventListener('visibilitychange', () => setPaused(() => {}));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(current + 1, 1);
      if (e.key === 'ArrowLeft') go(current - 1, -1);
    });

    // Swipe on touch screens.
    let startX: number | null = null;
    slidesBox.addEventListener('pointerdown', (e) => (startX = e.clientX));
    slidesBox.addEventListener('pointerup', (e) => {
      if (startX === null) return;
      const dx = e.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 50) go(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });

    schedule();
    syncState();
  }
</script>

<style>
  .hero-slider {
    position: relative;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: #111;
    color: #fff;
  }

  .slider {
    position: absolute;
    inset: 0;
    outline-offset: -3px;
  }

  .slider__slides {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }

  /* Soft dark gradients at the top (for the header) and bottom (for the heading and controls). */
  .slider__slides::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.42) 0%,
      rgb(0 0 0 / 0) 22%,
      rgb(0 0 0 / 0) 45%,
      rgb(0 0 0 / 0.62) 100%
    );
    pointer-events: none;
  }

  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    visibility: hidden;
  }

  .slide.is-active,
  .slide.is-leaving {
    visibility: visible;
  }

  .slide.is-active {
    z-index: 2;
  }

  .slide.is-leaving {
    z-index: 1;
  }

  .slide img,
  .slide__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .slide__placeholder {
    background: #2d2a25;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* First photo drifts in slowly on load. */
    .slide.is-active:not(.is-entering) img {
      animation: slide-settle 2400ms var(--ease) both;
    }

    /* Incoming slide wipes in from the side, its photo settling from a slight zoom (parallax feel). */
    .slide.is-entering {
      animation: slide-wipe 1400ms var(--ease) both;
    }

    .slide.is-entering img {
      animation: slide-settle 2000ms var(--ease) both;
    }

    .slide.is-leaving img {
      animation: slide-drift 1400ms var(--ease) both;
    }

    .slider__now.is-changing {
      animation: now-in 700ms var(--ease) 400ms both;
    }
  }

  @keyframes slide-wipe {
    from {
      clip-path: inset(0 calc(50% - 50% * var(--dir, 1)) 0 calc(50% + 50% * var(--dir, 1)));
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes slide-settle {
    from {
      transform: scale(1.12) translateX(calc(3% * var(--dir, 0)));
    }
  }

  @keyframes slide-drift {
    to {
      transform: translateX(calc(-10% * var(--dir, 1)));
    }
  }

  @keyframes now-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* Heading, bottom left. */
  .hero-slider__content {
    position: absolute;
    right: 0;
    bottom: clamp(6.5rem, 12vh, 8rem);
    left: 0;
    z-index: 4;
    pointer-events: none;
  }

  .hero-slider__content :global(a) {
    pointer-events: auto;
  }

  /* Current project + controls, bottom right (full width on phones). */
  .slider__bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    max-width: var(--container);
    margin-inline: auto;
    padding: var(--space-3) var(--gutter);
  }

  .slider__now {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    margin: 0;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .slider__city {
    color: rgb(255 255 255 / 0.75);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .slider__controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .slider__button {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 50%;
    background: none;
    color: #fff;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform 300ms var(--ease);
  }

  .slider__button:hover {
    border-color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  .slider__button--quiet {
    border-color: transparent;
    color: rgb(255 255 255 / 0.75);
  }

  .slider__button:focus-visible {
    outline-color: #fff;
  }

  .icon-play,
  .slider.is-user-paused .icon-pause {
    display: none;
  }

  .slider.is-user-paused .icon-play {
    display: block;
  }
</style>
