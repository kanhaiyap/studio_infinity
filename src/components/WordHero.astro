---
// Page opening used by Services and Projects: a lime chip and meta line, one lowercase word spread
// across the full width like the logo's "infinite" (the h1), then a statement sentence.
interface Props {
  word: string; // lowercase, shown letter by letter
  label: string; // the h1 text for screen readers and search engines
  chip: string;
  meta?: string[];
  intro: string;
}

const { word, label, chip, meta = [], intro } = Astro.props;
const letters = [...word];
---

<section class="word-hero">
  <p class="container word-hero__meta">
    <span class="word-hero__chip">{chip}</span>
    {meta.map((item) => <span>{item}</span>)}
  </p>
  <h1 class="word-hero__word" style={`--len: ${letters.length}`}>
    <span class="visually-hidden">{label}</span>
    <span class="word-hero__letters" aria-hidden="true">
      {
        letters.map((letter, i) => (
          <span class="word-hero__letter">
            <span style={`--i: ${i}`}>{letter}</span>
          </span>
        ))
      }
    </span>
  </h1>
  <div class="container">
    <p class="statement word-hero__intro">{intro}</p>
  </div>
</section>

<style>
  .word-hero {
    padding-block: var(--space-4) var(--space-6);
    overflow: hidden;
  }

  .word-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 2rem;
    margin-block: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .word-hero__chip {
    padding: 0.2rem 0.55rem;
    background: var(--color-pop);
    color: var(--color-on-pop);
  }

  .word-hero__word {
    margin: var(--space-3) 0 var(--space-5);
    font-size: min(calc(150vw / var(--len)), 15rem);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: 0;
  }

  .word-hero__letters {
    display: flex;
    justify-content: space-between;
    padding-inline: var(--gutter);
  }

  .word-hero__letter {
    display: inline-block;
    overflow: hidden;
    padding-block: 0.12em 0.12em; /* room for ascenders (f, d, l) and descenders (j, p) inside the mask */
    margin-block: -0.12em -0.12em;
  }

  .word-hero__letter > span {
    display: inline-block;
  }

  .word-hero__intro {
    max-width: 20em;
    margin-left: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word-hero__letter > span {
      animation: word-hero-letter-up 1300ms var(--ease) both;
      animation-delay: calc(150ms + var(--i) * 60ms);
    }

    .word-hero__meta,
    .word-hero__intro {
      animation: word-hero-fade 900ms var(--ease) 450ms both;
    }
  }

  @keyframes word-hero-letter-up {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes word-hero-fade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
