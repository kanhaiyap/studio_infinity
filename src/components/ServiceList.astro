---
// Large interactive list of services. With a mouse, hovering a row shows that service's photo floating
// beside the cursor, the other rows fade back, and the number becomes a lime chip.
// On touch screens each row shows a small photo instead.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url';

interface Props {
  items: { title: string; href: string; summary?: string; photo?: ImageMetadata }[];
}

const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="service-list" data-service-list>
  <ul>
    {
      items.map((item, i) => (
        <li data-reveal style={`--reveal-i: ${i}`}>
          <a href={url(item.href)} data-index={i}>
            <span class="service-list__num">{pad(i + 1)}</span>
            <span class="service-list__title">{item.title}</span>
            {item.summary && <span class="service-list__summary">{item.summary}</span>}
            {item.photo && <Image class="service-list__thumb" src={item.photo} alt="" widths={[160, 320]} sizes="5rem" />}
            <span class="service-list__arrow" aria-hidden="true">
              →
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="service-list__preview" aria-hidden="true" data-preview>
    {
      items.map((item, i) =>
        item.photo ? (
          <Image src={item.photo} alt="" widths={[480, 800]} sizes="22rem" data-preview-index={i} />
        ) : (
          <span data-preview-index={i} />
        ),
      )
    }
  </div>
</div>

<script>
  // Floating preview that follows the cursor (mouse only), easing towards it.
  const list = document.querySelector<HTMLElement>('[data-service-list]');
  const preview = list?.querySelector<HTMLElement>('[data-preview]');

  if (list && preview && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let x = 0;
    let y = 0;
    let tx = 0;
    let ty = 0;
    let frame = 0;

    const render = () => {
      x += (tx - x) * (reduce ? 1 : 0.14);
      y += (ty - y) * (reduce ? 1 : 0.14);
      preview.style.translate = `${x}px ${y}px`;
      frame = Math.abs(tx - x) + Math.abs(ty - y) > 0.5 ? requestAnimationFrame(render) : 0;
    };

    list.addEventListener('pointermove', (e) => {
      tx = e.clientX;
      ty = e.clientY;
      if (!preview.classList.contains('is-visible')) {
        x = tx;
        y = ty;
      }
      if (!frame) frame = requestAnimationFrame(render);
    });

    list.querySelectorAll<HTMLAnchorElement>('a[data-index]').forEach((link) => {
      link.addEventListener('pointerenter', () => {
        preview.querySelectorAll('[data-preview-index]').forEach((el) => {
          el.classList.toggle('is-active', el.getAttribute('data-preview-index') === link.dataset.index);
        });
        preview.classList.add('is-visible');
      });
      link.addEventListener('pointerleave', () => preview.classList.remove('is-visible'));
    });
  }
</script>

<style>
  .service-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--color-border);
  }

  .service-list a {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem var(--space-3);
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    transition: opacity 400ms var(--ease);
  }

  /* Other rows fade back while one is hovered. */
  @media (hover: hover) {
    .service-list ul:hover a:not(:hover) {
      opacity: 0.35;
    }
  }

  .service-list__num {
    justify-self: start;
    padding: 0.15rem 0.45rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    transition:
      background-color 300ms var(--ease),
      color 300ms var(--ease);
  }

  .service-list a:hover .service-list__num,
  .service-list a:focus-visible .service-list__num {
    background: var(--color-pop);
    color: var(--color-on-pop);
  }

  .service-list__title {
    font-size: clamp(2rem, 5.6vw, 5rem);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.03em;
    transition: transform 600ms var(--ease);
  }

  .service-list a:hover .service-list__title {
    transform: translateX(1rem);
  }

  .service-list__summary {
    grid-column: 2;
    max-width: 28rem;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .service-list__arrow {
    grid-column: 3;
    grid-row: 1;
    font-size: 1.75rem;
    font-weight: 300;
    transition: transform 450ms var(--ease);
  }

  .service-list a:hover .service-list__arrow {
    transform: translateX(0.5rem);
  }

  /* Touch screens: a small photo in each row instead of the floating preview. */
  .service-list__thumb {
    display: none;
  }

  @media (hover: none) {
    .service-list a {
      grid-template-columns: 2.5rem minmax(0, 1fr) 4.5rem;
    }

    .service-list__thumb {
      display: block;
      grid-column: 3;
      grid-row: 1 / span 2;
      width: 4.5rem;
      aspect-ratio: 4 / 5;
      object-fit: cover;
    }

    .service-list__arrow {
      display: none;
    }
  }

  @media (min-width: 64rem) {
    .service-list a {
      grid-template-columns: 4rem minmax(0, 1.5fr) minmax(0, 1fr) 2rem;
    }

    .service-list__summary {
      grid-column: 3;
      grid-row: 1;
    }

    .service-list__arrow {
      grid-column: 4;
    }
  }

  /* Floating preview: just right of the cursor (so the title stays readable), scales in. */
  .service-list__preview {
    --w: clamp(14rem, 22vw, 22rem);
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    width: var(--w);
    aspect-ratio: 4 / 5;
    margin: calc(var(--w) * -0.625) 0 0 2rem;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 350ms var(--ease),
      scale 500ms var(--ease);
  }

  .service-list__preview.is-visible {
    opacity: 1;
    scale: 1;
  }

  .service-list__preview > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 300ms var(--ease);
  }

  .service-list__preview > .is-active {
    opacity: 1;
  }

  @media (hover: none), (pointer: coarse) {
    .service-list__preview {
      display: none;
    }
  }
</style>
